Options -Indexes
DirectoryIndex index.html

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "no-referrer"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-vnuMJpwgjbekhS1DMBiMebwHFYZlgmHjpDi7oV29joM='; style-src 'self'; img-src 'self'; connect-src 'none'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'"
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=86400"
    Header set Cache-Control "public, max-age=2592000" "expr=%{QUERY_STRING} =~ /(^|&)v=[0-9]+(&|$)/"
  </FilesMatch>
  <FilesMatch "\.(webp|svg|png|ico)$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>
  Header always set X-Robots-Tag "noindex, follow" "expr=%{QUERY_STRING} =~ /(^|&)(mode=(mgexam|exam34|exam11)|tv=1)(&|$)/"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml application/xml text/plain
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^scripts/(?!learning(?:/|$)|ui(?:/|$)|site-config\.js$) - [F,L]
  RewriteRule ^(?:deployment|docs|dist|\.openai|\.git|\.vscode)(?:/|$) - [F,L]
  RewriteRule ^(?:README\.md|VALIDATION\.md|QUESTION_AUDIT\.json|validation\.json)$ - [F,L]
</IfModule>
